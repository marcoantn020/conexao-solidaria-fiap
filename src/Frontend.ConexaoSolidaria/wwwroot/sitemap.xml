<?xml version="1.0" encoding="UTF-8"?>
<!--
  Sitemap estático das rotas públicas do frontend (Conexão Solidária).
  Como é uma SPA Blazor WebAssembly renderizada no cliente, este arquivo lista
  a estrutura de páginas para referência/indexação — não é gerado dinamicamente.
  Rotas autenticadas (/campanhas, /campanhas/nova, /campanhas/{id}/editar,
  /doar/{id}) ficam de fora por exigirem login e não fazerem sentido indexadas.
-->
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
    <url>
        <loc>/</loc>
        <changefreq>daily</changefreq>
        <priority>1.0</priority>
    </url>
    <url>
        <loc>/login</loc>
        <changefreq>monthly</changefreq>
        <priority>0.5</priority>
    </url>
    <url>
        <loc>/cadastro</loc>
        <changefreq>monthly</changefreq>
        <priority>0.5</priority>
    </url>
</urlset>
